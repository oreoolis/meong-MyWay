# Env files. The glob matters: listing only `.env` and `.env.local` left
# `.env.production` (and any other suffix) committable at the repo root, while
# frontend/meong-my-way/.gitignore already used `.env*`. CI asserts this
# coverage — see .github/workflows/secret-scan.yml.
.env*
!.env.example
.claude
.agents

# Terraform — regenerated by `terraform init`/`apply`, never committed.
# .terraform.lock.hcl is intentionally NOT ignored: it pins provider versions
# and should be committed.
iac/.terraform/
iac/terraform.tfstate
iac/terraform.tfstate.backup
iac/*.tfvars
iac/*.tfvars.json
iac/*.tfplan
iac/crash.log

# Remove all docs and reasoning
docs/*
# Public Cognito identifiers for a browser app. These are configuration, not
# AWS credentials. The Cognito app client MUST be public and have no secret.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-southeast-1_EXAMPLE
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=examplepublicclientid

# --- Server-only. Never prefix any of these with NEXT_PUBLIC_. -------------
# Anything NEXT_PUBLIC_ is inlined into the browser bundle; an AWS secret key
# with that prefix is published to every visitor.

AWS_REGION=us-east-1

# From `terraform output` in iac/.
S3_BUCKET_NAME=meong-myway-uploads-000000000000
DYNAMODB_RESUMES_TABLE=meong-myway-resumes
DYNAMODB_ANALYSES_TABLE=meong-myway-analyses

# Omit these entirely in a deployed environment and let the task/instance role
# supply credentials. Locally, paste the trio from the AWS access portal.
# AWS_SESSION_TOKEN is required for temporary (ASIA...) credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Amazon Bedrock --------------------------------------------------------
# The five agents run here. Bedrock is not offered in every region and model
# availability differs between the ones where it is, so inference can sit apart
# from storage. Falls back to AWS_REGION when unset.
BEDROCK_REGION=us-east-1

# Claude Haiku 4.5 reads PDF/DOCX natively through Converse and stays grounded
# in the resume while arguing about it — roughly $0.05 per five-agent run, so
# a $20 budget covers ~350 analyses. See
# docs/adr/0002-claude-haiku-for-grounded-advice.md.
#
# NOTE the "us." prefix. Claude 4.x on Bedrock is inference-profile-only; the
# bare ID anthropic.claude-haiku-4-5-20251001-v1:0 is rejected with a
# ValidationException. `terraform output bedrock_reasoning_model_id` prints the
# correct value.
#
# amazon.nova-lite-v1:0 is ~20x cheaper (and needs no prefix) if the budget
# tightens. Whichever you pick must be enabled first under Bedrock > Model
# access.
BEDROCK_REASONING_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- SkillsFuture (SSG-WSG) Skills Framework API ---------------------------
# Paste the Client ID and Secret from your app's Credentials page on
# https://developer.swda.gov.sg (Account > Dashboard > your app > Credentials).
#
# REQUIRED for the Industry Advisor and Career Swapper agents. The portal
# documents these endpoints as "Authentication: Open", but calling them without
# a bearer token returns 401 "Authorization field missing" — verified against
# the live host. Left blank, those two agents are skipped and the app runs with
# the other three (parser, planner, improver).
#
# These are server-only secrets. Never add a NEXT_PUBLIC_ prefix.
SSG_CLIENT_ID=
SSG_CLIENT_SECRET=

# Point at https://mock-public-api.ssg-wsg.sg to develop against the portal's
# canned responses instead of live data. Defaults to the production host.
# SSG_API_BASE_URL=https://public-api.ssg-wsg.sg

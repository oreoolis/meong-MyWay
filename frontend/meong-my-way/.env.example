# Public Cognito identifiers for a browser app. These are configuration, not
# AWS credentials. The Cognito app client MUST be public and have no secret.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-southeast-1_EXAMPLE
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=examplepublicclientid

# --- Server-only. Never prefix any of these with NEXT_PUBLIC_. -------------
# Anything NEXT_PUBLIC_ is inlined into the browser bundle; an AWS secret key
# with that prefix is published to every visitor.

AWS_REGION=us-east-1

# From `terraform output` in iac/.
S3_BUCKET_NAME=meong-myway-uploads-000000000000
DYNAMODB_RESUMES_TABLE=meong-myway-resumes

# Omit these entirely in a deployed environment and let the task/instance role
# supply credentials. Locally, paste the trio from the AWS access portal.
# AWS_SESSION_TOKEN is required for temporary (ASIA...) credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
